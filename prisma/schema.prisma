generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Institution {
  id          String   @id @default(uuid())
  // title       String
  // location    String
  // country     String
  address     String
  lat         Float
  long        Float
  // website     String
  openalex_id String   @unique
  // type        String
  updated_at  DateTime @updatedAt
  created_at  DateTime @default(now())

  authors Author[]
  papers  Paper[]
}

model Author {
  id          String   @id @default(uuid())
  // full_name    String
  // display_name String
  openalex_id String   @unique
  // orcid        String
  // h_index      Int
  // summary      String
  updated_at  DateTime @updatedAt
  created_at  DateTime @default(now())

  institution    Institution @relation(fields: [institution_id], references: [id])
  institution_id String

  papers Paper[]

  @@index([institution_id])
}

model Paper {
  id          String   @id @default(uuid())
  doi         String   @unique
  // title       String
  // abstract     String
  openalex_id String   @unique
  // published_at DateTime
  // citations    Int
  updated_at  DateTime @updatedAt
  created_at  DateTime @default(now())

  authors      Author[]
  institutions Institution[]
}
