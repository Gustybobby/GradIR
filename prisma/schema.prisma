generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Institution {
  id         String   @id
  // title       String
  // location    String
  // country     String
  address    String
  lat        Float
  long       Float
  // website     String
  // type        String
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  authors Author[]
  papers  Paper[]
}

model Author {
  id         String   @id
  // full_name    String
  // display_name String
  // orcid        String
  // h_index      Int
  // summary      String
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  institution    Institution @relation(fields: [institution_id], references: [id])
  institution_id String

  papers Paper[]

  @@index([institution_id])
}

model Paper {
  id         String   @id
  doi        String   @unique
  // title       String
  // abstract     String
  // published_at DateTime
  // citations    Int
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  authors      Author[]
  institutions Institution[]
}
